{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "autoplay=(self \"https://www.youtube.com\"), encrypted-media=(self \"https://www.youtube.com\"), compute-pressure=(self \"https://www.youtube.com\")"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og-banners/(.*)",
      "destination": "/og-banners/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/:slug((?!dashboard|demo|login|register|api|assets|og-banners|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/preview?slug=$1"
    },
    {
      "source": "/api/midtrans/(.*)",
      "destination": "/api/midtrans?path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
